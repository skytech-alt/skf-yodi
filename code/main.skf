// ============================================
//   skf-yodi — мега-пакет от SkyMonder
//   Время + Рандом + Перевод
// ============================================


// --------------------------------------------
//   ВРЕМЯ
// --------------------------------------------

функция сейчас() {
    подключить_питон("datetime")
    пусть время = datetime.datetime.now()
    вернуть время.строка("%d.%m.%Y %H:%M:%S")
}

функция сегодня() {
    подключить_питон("datetime")
    вернуть datetime.date.today().строка("%d.%m.%Y")
}

функция день_недели() {
    подключить_питон("datetime")
    пусть дни = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
    вернуть дни[datetime.datetime.now().weekday()]
}

функция timestamp() {
    подключить_питон("time")
    вернуть time.time()
}


// --------------------------------------------
//   РАНДОМ
// --------------------------------------------

функция случайное_число(от, до) {
    подключить_питон("random")
    вернуть random.randint(от, до)
}

функция случайный_элемент(список) {
    подключить_питон("random")
    вернуть random.choice(список)
}

функция перемешать(список) {
    подключить_питон("random")
    random.shuffle(список)
    вернуть список
}

функция бросить_кубик() {
    вернуть случайное_число(1, 6)
}

функция подбросить_монету() {
    пусть стороны = ["Орёл", "Решка"]
    вернуть случайный_элемент(стороны)
}


// --------------------------------------------
//   ПЕРЕВОД
// --------------------------------------------

функция перевести(текст, с_языка, на_язык) {
    подключить_питон("requests")
    пусть адрес = "https://api.mymemory.translated.net/get?q=" + текст + "&langpair=" + с_языка + "|" + на_язык

    попробовать {
        пусть ответ = requests.get(адрес, timeout=10)
        пусть данные = ответ.json()

        если (данные["responseStatus"] == 200) {
            вернуть данные["responseData"]["translatedText"]
        } иначе {
            бросить "Ошибка перевода: " + данные["responseDetails"]
        }
    } поймать (ошибка) {
        бросить "Не удалось перевести: " + ошибка
    }
}

функция перевести_на_русский(текст) {
    вернуть перевести(текст, "en", "ru")
}

функция перевести_на_английский(текст) {
    вернуть перевести(текст, "ru", "en")
}
